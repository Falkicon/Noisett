{
  "name": "noisett-convex",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names convex,api --prefix-colors cyan,magenta \"npm run dev:convex\" \"npm run dev:api\"",
    "dev:convex": "convex dev",
    "dev:api": "python -m uvicorn src.server.api:app --reload --host 0.0.0.0 --port 8000",
    "deploy": "convex deploy",
    "update:pip": "python scripts/update_packages.py",
    "contracts:compile": "tsp compile contracts/main.tsp",
    "contracts:types": "openapi-typescript contracts/contracts/generated/openapi.yaml -o contracts/generated/types.ts",
    "contracts:python": "datamodel-codegen --input contracts/contracts/generated/openapi.yaml --output contracts/generated/python --output-model-type pydantic_v2.BaseModel --use-annotated",
    "contracts:generate": "npm run contracts:compile && npm run contracts:types && npm run contracts:python",
    "contracts:check": "npm run contracts:generate && git diff --exit-code contracts/generated/"
  },
  "dependencies": {
    "convex": "^1.31.4"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.8.0",
    "@typespec/http": "^1.8.0",
    "@typespec/json-schema": "^1.8.0",
    "@typespec/openapi3": "^1.8.0",
    "@typespec/rest": "^0.78.0",
    "concurrently": "^9.1.2",
    "openapi-typescript": "^7.10.1"
  }
}
