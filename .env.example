# Convex
CONVEX_URL=https://neighborly-gazelle-692.convex.site

# ML Backend: mock (default), replicate, fireworks, huggingface
ML_BACKEND=replicate

# Replicate (primary backend) - get token at https://replicate.com/account/api-tokens
# Set REPLICATE_API_TOKEN as a system environment variable (not in .env for security)
# REPLICATE_WEBHOOK_SECRET can be set here or as system env var
REPLICATE_WEBHOOK_SECRET=your_secret_here

# Fireworks (alternative backend, ~$0.003/image)
# FIREWORKS_API_KEY=your_api_key_here
# FIREWORKS_ACCOUNT_ID=your_account_id_here
